# ============================================================
# Employee Wiki Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Wiki app
# ------------------------------------------------------------
WIKI_PORT=8000
APP_TITLE=Employee Wiki Assistant

# Custom system prompt (optional — leave blank to use default)
SYSTEM_PROMPT=

# ------------------------------------------------------------
# OpenRAG connection
# Point to your running OpenRAG instance.
# If running via docker-compose, the default below works as-is.
# For an external instance, use its full URL.
# ------------------------------------------------------------
OPENRAG_BASE_URL=http://localhost:8080/api/v1
OPENRAG_API_KEY=changeme          # Must match AUTH_TOKEN in OpenRAG
OPENRAG_MODEL=openrag             # Run GET /api/v1/models to list available models
OPENRAG_PORT=8080
OPENRAG_INDEXER_PORT=8081

# ------------------------------------------------------------
# LLM backend (used by OpenRAG internally)
# OpenRAG needs an LLM to generate answers from retrieved docs.
# Option A: OpenAI
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Option B: Azure OpenAI
#   LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   LLM_API_KEY=<azure-key>
#   LLM_MODEL=gpt-4o
#
# Option C: Ollama (local, no API key needed)
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
# ------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Embeddings (used by OpenRAG internally)
# Default uses Jina AI embeddings (runs locally, no key needed).
# ------------------------------------------------------------
EMBEDDER_MODEL=jinaai/jina-embeddings-v3
RERANKER_ENABLED=false
