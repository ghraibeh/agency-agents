# ============================================================
# Employee Wiki Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Wiki app
# ------------------------------------------------------------
WIKI_PORT=8000
APP_TITLE=Employee Wiki Assistant

# Custom system prompt (optional — leave blank to use default)
SYSTEM_PROMPT=

# ------------------------------------------------------------
# OpenRAG connection
#
# OPENRAG_BASE_URL: Root URL of your OpenRAG instance (no /v1 suffix).
#   - Docker Compose default: http://openrag:8080  (service name)
#   - External instance:      http://your-server:8080
#
# OPENRAG_API_KEY: Must match AUTH_TOKEN set in OpenRAG.
#   Default: sk-openrag-1234  (change in production!)
#
# OPENRAG_MODEL: Which partition(s) to query.
#   - openrag-all          → query all partitions the token can access
#   - openrag-default      → query the "default" partition only
#   - openrag-{name}       → query a specific named partition
#
# OPENRAG_PARTITION: Partition used for document uploads.
# ------------------------------------------------------------
OPENRAG_BASE_URL=http://localhost:8080
OPENRAG_API_KEY=sk-openrag-1234
OPENRAG_MODEL=openrag-all
OPENRAG_PARTITION=default
OPENRAG_PORT=8080
CHAINLIT_PORT=8090
INDEXER_PORT=3042

# ------------------------------------------------------------
# LLM backend (used by OpenRAG to generate answers)
# OpenRAG requires an external LLM — it has no built-in model.
#
# Option A: OpenAI
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Option B: Azure OpenAI
#   LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   LLM_API_KEY=<azure-key>
#   LLM_MODEL=gpt-4o
#
# Option C: Ollama (local, no API key required)
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
#
# Option D: vLLM (self-hosted)
#   LLM_BASE_URL=http://your-vllm-host:8000/v1
#   LLM_API_KEY=EMPTY
#   LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# ------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Embeddings
# Jina v3 runs locally via the vllm service — no API key needed.
# Only change this if using a different embedding model or provider.
# ------------------------------------------------------------
EMBEDDER_MODEL=jinaai/jina-embeddings-v3

# ------------------------------------------------------------
# Retrieval tuning
# ------------------------------------------------------------
RETRIEVER_TOP_K=20
RERANKER_ENABLED=false

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
